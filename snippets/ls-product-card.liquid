{%- comment -%}
  Product card for the collection grid.
  Params:
    product  — product object (required)
    subtitle — global section-level fallback line (used when nothing else is set)
    eager    — true to load the image eagerly (above-the-fold cards)

  Subtitle priority (all shown as the same ls-pc__subtitle line):
    1. product.metafields.lumiere.card_subtitle — "Subtitle" field in Shopify Admin product metafields
    2. Gift Set auto-fallback             — if product type == "Gift Set" and subtitle is blank
    3. section subtitle                   — "100% Mulberry Silk · Hand-Rolled Edges" global line
{%- endcomment -%}

{%- comment -%} 1. Custom metafield subtitle (Admin → Product → Metafields → Subtitle) {%- endcomment -%}
{%- assign card_subtitle = product.metafields.lumiere.card_subtitle.value -%}

{%- comment -%} 2. Gift Set auto-fallback if subtitle is empty {%- endcomment -%}
{%- if card_subtitle == blank and product.type == 'Gift Set' -%}
  {%- assign card_subtitle = 'Includes Signature Brooch & Luxury Gift Box' -%}
{%- endif -%}

{%- comment -%} 3. Section-level global subtitle if still empty {%- endcomment -%}
{%- if card_subtitle == blank -%}
  {%- assign card_subtitle = subtitle -%}
{%- endif -%}

<a class="ls-pc" href="{{ product.url }}">
  <div class="ls-pc__media">
    {%- if product.featured_image -%}
      <img
        class="ls-pc__img"
        src="{{ product.featured_image | image_url: width: 900 }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="{% if eager %}eager{% else %}lazy{% endif %}"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
      >
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'ls-pc__placeholder' }}
    {%- endif -%}

    {%- if product.available == false -%}
      <span class="ls-pc__badge">Sold Out</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="ls-pc__badge">Sale</span>
    {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
      <span class="ls-pc__badge">New Arrival</span>
    {%- elsif product.tags contains 'bestseller' or product.tags contains 'Bestseller' -%}
      <span class="ls-pc__badge">Bestseller</span>
    {%- endif -%}
  </div>

  <div class="ls-pc__info">
    <div class="ls-pc__name-group">
      <span class="ls-pc__name">{{ product.title }}</span>
      {%- if card_subtitle != blank -%}
        <span class="ls-pc__subtitle">{{ card_subtitle }}</span>
      {%- endif -%}
    </div>
    <span class="ls-pc__price">
      {%- if product.compare_at_price > product.price -%}
        <s>{{ product.compare_at_price | money }}</s>
      {%- endif -%}
      {{ product.price | money }}
    </span>
  </div>
</a>
